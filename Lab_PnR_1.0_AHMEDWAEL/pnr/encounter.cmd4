zoomBox -2.849 117.417 31.727 110.652
zoomBox 5.554 115.419 13.369 112.139
selectInst FE_OFC77_Arith_Flag
zoomBox 89.305 72.618 147.785 36.087
zoomBox 97.454 54.872 118.898 46.352
deselectAll
selectInst U1
deselectAll
getIoFlowFlag
clearClockDomains
setClockDomains -all
timeDesign -preCTS -idealClock -pathReports -drvReports -slackReports -numPaths 50 -prefix ALU_TOP_preCTS -outDir timingReports
saveDesign /home/ahesham/Labs/Lab_PNR_1/pnr/ALU_TOP.enc
saveDesign /home/ahesham/Labs/Lab_PNR_1/pnr/ALU_TOP_PLACE.enc
