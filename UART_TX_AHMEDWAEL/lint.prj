##Data Import Section

read_file -type verilog ../rtl/FSM.v
read_file -type verilog ../rtl/MUX.v
read_file -type verilog ../rtl/Parity.v
read_file -type verilog ../rtl/Serializer.v
read_file -type verilog ../rtl/UART_TOP_TX.v
read_file -type verilog ../rtl/uart_tx_defines.v
read_file -type gateslib ../std_cells/scmetro_tsmc_cl013g_rvt_tt_1p2v_25c.lib

##Common Options Section

set_option projectwdir .
set_option language_mode mixed
set_option designread_enable_synthesis no
set_option designread_disable_flatten no
set_option incdir { ../rtl }
set_option active_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff


##Goal Setup Section

current_methodology $SPYGLASS_HOME/GuideWare/latest/block/rtl_handoff


current_goal lint/lint_rtl -alltop
set_goal_option addrules { UndrivenNUnloaded-ML }

